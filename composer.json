{
    "name": "innis/nostr-sign-in",
    "description": "NIP-98 sign-in for Symfony applications riding Symfony Security: one signed proof opens the firewall session, roles and voters do the rest",
    "type": "library",
    "license": "MIT",
    "keywords": ["nostr", "nip-98", "symfony", "security", "authentication", "sign-in"],
    "authors": [
        {
            "name": "John Innis",
            "email": "john@innis.xyz",
            "homepage": "https://www.innis.xyz/"
        }
    ],
    "require": {
        "php": "^8.4",
        "innis/nostr-core": "^0.10",
        "psr/cache": "^3",
        "symfony/event-dispatcher": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/security-http": "^8.0"
    },
    "suggest": {
        "symfony/rate-limiter": "Enables login_throttling on the sign-in firewall, which the authenticator is shaped for",
        "symfony/security-bundle": "Runs the firewall this package plugs into; only pure-component use goes without it"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "innis/coding-standards": "^0.2",
        "phpstan/phpstan": "~2.3.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.1",
        "rector/rector": "~2.7.0",
        "symfony/browser-kit": "^8.0",
        "symfony/cache": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/security-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Innis\\Nostr\\SignIn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innis\\Nostr\\SignIn\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "@analyse"
        ],
        "test-unit": "phpunit --testsuite=Unit",
        "test-integration": "phpunit --testsuite=Integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/tests/coverage/html --coverage-text --coverage-clover var/tests/coverage/clover.xml",
        "analyse": "phpstan analyse",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "check-rector": "rector process --dry-run",
        "check-path-lengths": "check-path-lengths"
    },
    "config": {
        "sort-packages": true
    }
}
